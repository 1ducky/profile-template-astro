---
import GridLayout from "../Grid/Grid.astro";
import Section from "../Grid/Section.astro";

interface Props {
    title: string;
    eyebrow?: string;
    description?: string;
}
const { title, eyebrow = "Statistik", description } = Astro.props;
---

<Section class="">
    <header
        class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
        <div>
            <p
                class="text-xs font-semibold uppercase tracking-eyebrow text-primary"
            >
                {eyebrow}
            </p>
            <h1 class="mt-1 text-3xl md:text-4xl">{title}</h1>
            {
                description && (
                    <p class="mt-2 max-w-xl text-muted">{description}</p>
                )
            }
        </div>
        <!-- slot untuk RangeSelector -->
        <div><slot name="actions" /></div>
    </header>

    <!-- Seluruh isi dashboard berada di grid 12 kolom -->
    <GridLayout gap="md"><slot /></GridLayout>
</Section>

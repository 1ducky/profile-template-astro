---
/**
 * Grid 12 kolom di SEMUA ukuran layar.
 * Lebar tiap anak diatur lewat <GridItem base md lg>.
 */
interface Props {
    gap?: "sm" | "md" | "lg";
    class?: string;
}
const { gap = "md", class: className } = Astro.props;
const gaps = { sm: "gap-3", md: "gap-3 md:gap-5", lg: "gap-4 md:gap-8" };
---

<div class:list={["grid grid-cols-12", gaps[gap], className]}>
    <slot />
</div>

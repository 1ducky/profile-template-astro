---
/** Kartu dasar: putih, radius 16px, shadow lembut, border tipis (design.md §6). */
interface Props {
    class?: string;
    padded?: boolean;
}
const { class: className, padded = true } = Astro.props;
---

<div
    class:list={[
        "h-full rounded-card border border-ink/5 bg-white shadow-card",
        padded && "p-5 md:p-6",
        className,
    ]}
>
    <slot />
</div>

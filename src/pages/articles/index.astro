---
import Layout from "../../layouts/Layout.astro";
import ArticleContainer from "../../layouts/Article/Container.astro";
import ArticleFooter from "../../layouts/Article/Footer.astro";
import ArticleHeader from "../../layouts/Article/Header.astro";

import HeadlineSection from "../../components/Article/Headline";
import Galery from "../../components/Article/Galery";
import AdsSection from "../../components/Article/Ads";
import VListed from "../../components/Article/VListed.astro";
import { mockArticles } from "../../data/article/Articles";
import Fragment from "../../layouts/Article/Fragment.astro";
import HListed from "../../components/Article/HListed.astro";
---

<Layout>
    <ArticleHeader />
    <ArticleContainer class="mt-5">
        <HeadlineSection article={mockArticles.slice(0, 5)} client:visible />
        <Fragment>
            <VListed articles={mockArticles} client:visible />
            <div class="" slot="sidebar">
                <div class="aspect-4/3">
                    <Galery galery={mockArticles.slice(0, 5)} client:visible />
                </div>
                <AdsSection>
                    <VListed articles={mockArticles} client:visible />
                </AdsSection>
            </div>
        </Fragment>
        <HListed articles={mockArticles.slice(0, 5)} client:visible />
        <Fragment>
            <VListed articles={mockArticles} client:visible />
            <div class="" slot="sidebar">
                <div class="aspect-4/3">
                    <Galery galery={mockArticles.slice(0, 5)} client:visible />
                </div>
                <AdsSection>
                    <VListed articles={mockArticles} client:visible />
                </AdsSection>
            </div>
        </Fragment>
    </ArticleContainer>
    <ArticleFooter />
</Layout>

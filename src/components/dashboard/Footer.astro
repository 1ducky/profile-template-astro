---
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-navy text-white">
    <div class="mx-auto max-w-page px-5 py-14 md:px-8">
        <div
            class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
        >
            <div class="max-w-md">
                <h2 class="text-2xl">Mari Terhubung</h2>
                <p class="mt-2 text-white/70">
                    Terbuka untuk kolaborasi, diskusi, dan kesempatan berdampak
                    bersama.
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row">
                <a
                    href="/kontak"
                    class="rounded-full bg-primary px-6 py-3 text-center text-sm font-semibold hover:brightness-110"
                    >Hubungi Saya</a
                >
                <a
                    href="#"
                    class="rounded-full border border-white/70 px-6 py-3 text-center text-sm font-semibold hover:bg-white/10"
                    >Ikuti di Media Sosial</a
                >
            </div>
        </div>
        <p class="mt-12 border-t border-white/10 pt-6 text-sm text-white/60">
            © {year} Puguh Pamungkas. Teknologi untuk manusia, bukan sebaliknya.
        </p>
    </div>
</footer>

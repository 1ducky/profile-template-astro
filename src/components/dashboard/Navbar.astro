---
interface Props {
    current?: string;
}
const { current = "/" } = Astro.props;

const links = [
    { href: "/", label: "Beranda" },
    { href: "/tentang", label: "Tentang" },
    { href: "/produk", label: "Produk" },
    { href: "/dampak-sosial", label: "Dampak Sosial" },
    { href: "/artikel", label: "Artikel" },
    { href: "/kontak", label: "Kontak" },
];
const isActive = (href: string) =>
    href === "/" ? current === "/" : current.startsWith(href);
---

<header
    class="sticky top-0 z-50 border-b border-ink/5 bg-white/85 backdrop-blur"
>
    <nav
        class="mx-auto flex h-16 max-w-page items-center justify-between gap-6 px-5 md:px-8"
        aria-label="Navigasi utama"
    >
        <a href="/" class="flex items-center gap-2.5 font-bold">
            <span
                class="grid size-9 place-items-center rounded-full bg-primary text-sm text-white"
                aria-hidden="true">PP</span
            >
            <span class="text-[15px]">Puguh Pamungkas</span>
        </a>

        <ul class="hidden items-center gap-7 text-sm lg:flex">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            aria-current={isActive(l.href) ? "page" : undefined}
                            class:list={[
                                "transition-colors hover:text-primary",
                                isActive(l.href)
                                    ? "font-semibold text-primary"
                                    : "text-ink",
                            ]}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-3">
            <a
                href="/kontak"
                class="hidden rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary sm:inline-block"
            >
                Hubungi Saya
            </a>
            <button
                id="nav-toggle"
                class="grid size-10 place-items-center rounded-full border border-ink/10 lg:hidden"
                aria-label="Buka menu"
                aria-expanded="false"
                aria-controls="nav-mobile"
            >
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                    ><path d="M4 7h16M4 12h16M4 17h16"></path></svg
                >
            </button>
        </div>
    </nav>

    <div
        id="nav-mobile"
        class="hidden border-t border-ink/5 bg-white lg:hidden"
    >
        <ul class="mx-auto flex max-w-page flex-col px-5 py-3 md:px-8">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            class:list={[
                                "block py-3 text-sm",
                                isActive(l.href)
                                    ? "font-semibold text-primary"
                                    : "text-ink",
                            ]}
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
            <li class="pt-2 pb-3">
                <a
                    href="/kontak"
                    class="block rounded-full bg-primary py-3 text-center text-sm font-semibold text-white"
                    >Hubungi Saya</a
                >
            </li>
        </ul>
    </div>
</header>

<script>
    const btn = document.getElementById("nav-toggle");
    const panel = document.getElementById("nav-mobile");
    btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        btn.setAttribute("aria-label", open ? "Buka menu" : "Tutup menu");
        panel?.classList.toggle("hidden", open);
    });
</script>

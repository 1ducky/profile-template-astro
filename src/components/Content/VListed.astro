---
import type { ArticleResponse } from '../../api-client/contract/article';
import { ResolveUrlAsset } from '../../utils/resolve-url';
import { ArticleThumbnail } from './Thubnail';

interface Props {
  /** Daftar artikel yang akan ditampilkan */
  articles: ArticleResponse[];
  /** Judul section, default: "BERITA TERKINI" */
  title?: string;
}

const { articles = [], title = "BERITA TERKINI" } = Astro.props;

// ============================================================
// UTILITY FUNGSI
// ============================================================
// Fungsi untuk mengubah ISO Date string menjadi format "X menit/jam lalu"
function timeAgo(dateString: string) {
  const date = new Date(dateString);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);

  if (diffInSeconds < 60) return "Baru saja";
  
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes} menit`;

  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours} jam`;

  const diffInDays = Math.floor(diffInHours / 24);
  return `${diffInDays} hari`;
}
---

<section class="w-full font-sans mx-auto bg-white">
  <!-- Header Section -->
  <div class="border-b-2 border-gray-100 pb-2 mb-4">
    <h2 class="text-xl font-bold text-gray-900 tracking-tight uppercase">
      {title}
    </h2>
  </div>

  <!-- List Container -->
  <div class="flex flex-col">
    {articles.map((article, index) => (
      <article 
        class:list={[
          "flex flex-row items-stretch justify-between py-5 gap-4 group",
          // Beri border bawah kecuali untuk item terakhir
          index !== articles.length - 1 && "border-b border-gray-100"
        ]}
      >
        <div class="shrink-0 w-[110px] sm:w-[150px] md:w-[180px]">
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-gray-200">
            {article.cover ? (
              <ArticleThumbnail 
                image={{ alt: article.title, src: ResolveUrlAsset(article.cover), caption: title }}
                priority={false}
                className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center text-gray-400 bg-gray-100">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            )}
          </div>
        </div>
        <!-- Kiri: Konten Teks -->
        <div class="flex flex-col justify-between flex-1">
          <a href={article.url || `/articles/${article.slug}`} class="block">
            <h3 class="text-[19px] md:text-[22px] font-normal leading-snug text-[#3b5998] group-hover:text-blue-700 transition-colors line-clamp-3">
              {article.title}
            </h3>
          </a>
          
          <!-- Meta (Kategori & Waktu) -->
          <div class="flex items-center gap-3 mt-3">
            <span class="text-[12px] font-semibold text-[#e74c3c] uppercase tracking-wide">
              {article.category || "UMUM"}
            </span>
            {
              article.published_at && (

            <span class="text-[13px] text-gray-500 font-normal">
              {timeAgo(article.published_at)}
            </span>
              )
            }
          </div>
        </div>


        
      </article>
    ))}
  </div>
</section>
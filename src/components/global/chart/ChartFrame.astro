---
/**
 * Kerangka bersama LineChart & BarChart: legenda, sumbu-y, gridline,
 * label sumbu-x, tooltip hover/keyboard, dan tabel tersembunyi untuk screen reader.
 * Komponen anak hanya menggambar <svg> data lewat slot.
 */
import {
    type ResolvedSeries,
    formatCompact,
    formatFull,
    visibleLabelIndexes,
} from "./type.ts";

interface Props {
    kind: "line" | "bar";
    labels: string[];
    series: ResolvedSeries[];
    xs: number[];
    scale: { max: number; ticks: number[] };
    height: number;
    maxXLabels: number;
    showLegend: boolean;
    ariaLabel: string;
    formatTick?: (n: number) => string;
    formatValue?: (n: number) => string;
    /** Baris tambahan di tooltip, mis. rasio atau catatan */
    tooltipNote?: (index: number) => string | undefined;
    /** Lebar pita sorot (dalam %) untuk bar chart */
    band?: number;
}
const {
    kind,
    labels,
    series,
    xs,
    scale,
    height,
    maxXLabels,
    showLegend,
    ariaLabel,
    formatTick = formatCompact,
    formatValue = formatFull,
    tooltipNote,
    band = 0,
} = Astro.props;

const pct = (v: number) => (v / scale.max) * 100;
const shown = visibleLabelIndexes(labels.length, maxXLabels);

const tooltip = labels.map((label, i) => ({
    x: xs[i],
    label,
    note: tooltipNote?.(i) ?? null,
    rows: series.map((s) => {
        const v = s.values[i];
        return {
            name: s.label,
            color: s.color,
            value: v == null ? "–" : formatValue(v),
            y: kind === "line" && v != null ? 100 - pct(v) : null,
        };
    }),
}));
---

<figure
    class="w-full pr-3"
    data-chart
    data-kind={kind}
    data-band={band}
    data-tooltip={JSON.stringify(tooltip)}
>
    {
        showLegend && (
            <ul class="mb-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
                {series.map((s) => (
                    <li class="flex items-center gap-2">
                        <span
                            class="size-2.5 rounded-full"
                            style={`background:${s.color}`}
                            aria-hidden="true"
                        />
                        {s.label}
                    </li>
                ))}
            </ul>
        )
    }

    <div class="flex" style={`height:${height}px`}>
        <!-- sumbu-y -->
        <div class="relative w-12 shrink-0" aria-hidden="true">
            {
                scale.ticks.map((t) => (
                    <span
                        class="absolute right-2 translate-y-1/2 text-xs text-muted"
                        style={`bottom:${pct(t)}%`}
                    >
                        {formatTick(t)}
                    </span>
                ))
            }
        </div>

        <!-- area plot -->
        <div
            class="relative flex-1 touch-pan-y rounded-sm border-b border-ink/15"
            data-plot
            tabindex="0"
            role="img"
            aria-label={ariaLabel}
        >
            {
                scale.ticks
                    .slice(1)
                    .map((t) => (
                        <div
                            class="pointer-events-none absolute inset-x-0 border-t border-ink/10"
                            style={`bottom:${pct(t)}%`}
                        />
                    ))
            }

            <slot />

            <div
                data-guide
                class="pointer-events-none absolute inset-y-0 hidden bg-ink/10"
                style="width:1px"
            >
            </div>
            <div data-dots class="pointer-events-none absolute inset-0"></div>
            <div
                data-tip
                role="status"
                class="pointer-events-none absolute top-2 z-10 hidden min-w-40 rounded-xl border border-ink/5 bg-white px-3 py-2 text-sm shadow-card"
            >
            </div>
        </div>
    </div>

    <!-- label sumbu-x -->
    <div class="relative ml-12 mt-2 h-5" aria-hidden="true">
        {
            shown.map((i) => (
                <span
                    class="absolute -translate-x-1/2 whitespace-nowrap text-xs text-muted"
                    style={`left:${xs[i]}%`}
                >
                    {labels[i]}
                </span>
            ))
        }
    </div>

    <!-- alternatif teks untuk screen reader -->
    <table class="sr-only">
        <caption>{ariaLabel}</caption>
        <thead
            ><tr><th>Label</th>{series.map((s) => <th>{s.label}</th>)}</tr
            ></thead
        >
        <tbody>
            {
                labels.map((l, i) => (
                    <tr>
                        <th>{l}</th>
                        {series.map((s) => (
                            <td>
                                {s.values[i] == null
                                    ? "–"
                                    : formatValue(s.values[i] as number)}
                            </td>
                        ))}
                    </tr>
                ))
            }
        </tbody>
    </table>
</figure>

<script>
    type Row = { name: string; color: string; value: string; y: number | null };
    type Tip = { x: number; label: string; note: string | null; rows: Row[] };

    function init(root: HTMLElement) {
        const data: Tip[] = JSON.parse(root.dataset.tooltip ?? "[]");
        const kind = root.dataset.kind;
        const band = Number(root.dataset.band ?? 0);
        const plot = root.querySelector<HTMLElement>("[data-plot]")!;
        const guide = root.querySelector<HTMLElement>("[data-guide]")!;
        const dots = root.querySelector<HTMLElement>("[data-dots]")!;
        const tip = root.querySelector<HTMLElement>("[data-tip]")!;
        let current = -1;

        const el = (tag: string, cls = "", text = "") => {
            const n = document.createElement(tag);
            if (cls) n.className = cls;
            if (text) n.textContent = text;
            return n;
        };

        function show(i: number) {
            if (i < 0 || i >= data.length) return;
            current = i;
            const d = data[i];

            guide.classList.remove("hidden");
            guide.style.left = band ? `${d.x - band / 2}%` : `${d.x}%`;
            guide.style.width = band ? `${band}%` : "1px";

            dots.replaceChildren();
            if (kind === "line") {
                d.rows.forEach((r) => {
                    if (r.y == null) return;
                    const dot = el(
                        "span",
                        "absolute size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white",
                    );
                    dot.style.left = `${d.x}%`;
                    dot.style.top = `${r.y}%`;
                    dot.style.background = r.color;
                    dots.append(dot);
                });
            }

            tip.replaceChildren(el("p", "mb-1 font-semibold", d.label));
            d.rows.forEach((r) => {
                const row = el("p", "flex items-center justify-between gap-4");
                const name = el("span", "flex items-center gap-2 text-muted");
                const sw = el("span", "size-2 rounded-full");
                sw.style.background = r.color;
                name.append(sw, r.name);
                row.append(
                    name,
                    el("span", "font-medium tabular-nums", r.value),
                );
                tip.append(row);
            });
            if (d.note)
                tip.append(
                    el(
                        "p",
                        "mt-1 border-t border-ink/10 pt-1 text-xs text-muted",
                        d.note,
                    ),
                );

            tip.classList.remove("hidden");
            tip.style.left = `${d.x}%`;
            tip.style.transform =
                d.x > 55
                    ? "translateX(calc(-100% - 12px))"
                    : "translateX(12px)";
        }

        function hide() {
            current = -1;
            guide.classList.add("hidden");
            tip.classList.add("hidden");
            dots.replaceChildren();
        }

        plot.addEventListener("pointermove", (e) => {
            const r = plot.getBoundingClientRect();
            const x = ((e.clientX - r.left) / r.width) * 100;
            let best = 0;
            data.forEach((d, i) => {
                if (Math.abs(d.x - x) < Math.abs(data[best].x - x)) best = i;
            });
            if (best !== current) show(best);
        });
        plot.addEventListener("pointerleave", hide);
        plot.addEventListener("blur", hide);
        plot.addEventListener("focus", () => show(data.length - 1));
        plot.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight") {
                e.preventDefault();
                show(Math.min(data.length - 1, current + 1));
            } else if (e.key === "ArrowLeft") {
                e.preventDefault();
                show(Math.max(0, current - 1));
            } else if (e.key === "Escape") hide();
        });
    }

    document.querySelectorAll<HTMLElement>("[data-chart]").forEach(init);
</script>
